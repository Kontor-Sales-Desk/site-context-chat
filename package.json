{
  "name": "site-context-chat",
  "version": "5.4.0",
  "description": "Markdown-backed site chatbot with Supabase Edge Functions, admin panel, and draggable widget.",
  "keywords": [
    "chatbot",
    "anthropic",
    "claude",
    "react",
    "supabase",
    "edge-functions"
  ],
  "license": "MIT",
  "homepage": "https://getkontor.eu/support-software",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kontor-Sales-Desk/site-context-chat"
  },
  "type": "module",
  "main": "./dist/site-context-chat.js",
  "module": "./dist/site-context-chat.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts",
      "default": "./dist/site-context-chat.js"
    },
    "./widget": {
      "import": "./src/widget.js",
      "types": "./src/widget.d.ts"
    },
    "./admin": {
      "import": "./src/admin.js",
      "types": "./src/admin.d.ts"
    },
    "./styles.css": "./src/styles.css",
    "./embed": "./dist/embed/site-context-chat-embed.js",
    "./shopCatalog.json": "./supabase/functions/_shared/shopCatalog.json",
    "./osmBusinessCategories": "./supabase/functions/_shared/osmBusinessCategories.ts"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "supabase/functions/_shared/shopCatalog.json",
    "supabase/functions/_shared/osmBusinessCategories.ts",
    "!**/.ccdiffs",
    "!**/.temp",
    "!**/*.map"
  ],
  "bin": {
    "site-context-chat": "./bin/site-context-chat.mjs"
  },
  "scripts": {
    "build": "vite build && cp src/index.d.ts dist/index.d.ts && cp src/widget.d.ts dist/widget.d.ts && cp src/admin.d.ts dist/admin.d.ts",
    "build:embed": "vite build --config vite.embed.config.ts",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build && npm run build:embed",
    "test:edge": "node scripts/test-edge.mjs"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react-icons": "^5",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5",
    "vite": "^5"
  }
}
